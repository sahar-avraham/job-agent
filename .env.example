# Copy to .env and fill in. .env is never committed.

# Shown on the CV and in application mail.
CANDIDATE_NAME=Dana Levi
CANDIDATE_PHONE=050-0000000
CANDIDATE_EMAIL=dana.levi@example.com
CANDIDATE_LINKEDIN=linkedin.com/in/dana-levi
CANDIDATE_GITHUB=github.com/dana-levi

# Spellings of the home city; the report marks jobs there.
HOME_CITY=tel aviv,תל אביב

# Gmail, for reading replies and sending applications you approve.
# An app password from myaccount.google.com/apppasswords, not the account password.
GMAIL_ADDRESS=dana.levi@example.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
